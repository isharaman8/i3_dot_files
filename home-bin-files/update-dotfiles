#!/bin/bash

# === Variables ===
BACKUP_ROOT=~/Documents/DOT_FILES/i3_dot_files_update
CONFIG_SRC=~/.config
BIN_SRC=~/bin
LOCAL_BIN_SRC=~/.local/bin
LOCAL_SHARE_SRC=~/.local/share
LOG_DIR=~/bin/logs
LOG_FILE=$LOG_DIR/update-dotfiles.log

CONFIG_DIRS=(
  alacritty
  conky
  fish
  i3
  nvim
  picom
  polybar
  ranger
  systemd
)

# === Ensure log directory exists ===
mkdir -p "$LOG_DIR"

# === Log function ===
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

# === Array of items to back up ===
declare -A BACKUP_PATHS
BACKUP_PATHS["$CONFIG_SRC"]="home-config-files"
BACKUP_PATHS["$BIN_SRC"]="home-bin-files"
BACKUP_PATHS["$LOCAL_BIN_SRC"]="home-local-bin-files"
BACKUP_PATHS["$LOCAL_SHARE_SRC"]="home-local-share-files"

# === Function for copy ===
backup_dir() {
  local src=$1
  local dest=$2

  log "Backing up from $src to $BACKUP_ROOT/$dest"
  mkdir -p "$BACKUP_ROOT/$dest"

  if [[ "$src" == "$BIN_SRC" ]]; then
    # bin: use rsync, exclude logs
    rsync -av --exclude='logs' "$src"/ "$BACKUP_ROOT/$dest/" | tee -a "$LOG_FILE"

  elif [[ "$src" == "$CONFIG_SRC" ]]; then
    # config: only copy selected folders
    for dir in "${CONFIG_DIRS[@]}"; do
      if [ -d "$src/$dir" ]; then
        cp -rv "$src/$dir" "$BACKUP_ROOT/$dest" | tee -a "$LOG_FILE"
      else
        log "⚠️ Skipping missing config: $src/$dir"
      fi
    done

  elif [[ "$src" == "$LOCAL_SHARE_SRC" ]]; then
    # local/share: only copy archlinux-logout
    if [ -d "$src/archlinux-logout" ]; then
      cp -rv "$src/archlinux-logout" "$BACKUP_ROOT/$dest" | tee -a "$LOG_FILE"
    else
      log "⚠️ Skipping missing: $src/archlinux-logout"
    fi

  else
    # default: copy everything
    cp -rv "$src"/* "$BACKUP_ROOT/$dest/" | tee -a "$LOG_FILE"
  fi
}

# function for copying pacman installed packages (aur included)
backup_packages() {
  local package_directory="package-list"
  cd "$BACKUP_ROOT" || {
    log "x Failed to cd into $BACKUP_ROOT"
    exit 1
  }

  if [ ! -d "$package_directory" ]; then
    log "[WARNING] directory $BACKUP_ROOT/$package_directory does not exist, creating one!"

    mkdir "$package_directory"
  fi

  cd "$package_directory"

  pacman -Qqe >pkglist.txt
  pacman -Qqm >aurlist.txt
}

# use package backup
backup_packages

# === Loop through sources ===
for src in "${!BACKUP_PATHS[@]}"; do
  backup_dir "$src" "${BACKUP_PATHS[$src]}"
done

# === Git commit ===
cd "$BACKUP_ROOT" || {
  log "❌ Failed to cd into $BACKUP_ROOT"
  exit 1
}
git add . >>"$LOG_FILE" 2>&1
git commit -m "regular files update" >>"$LOG_FILE" 2>&1
git push -u origin arcolinux-branch >>"$LOG_FILE" 2>&1

log "✅ Backup and git push completed"
