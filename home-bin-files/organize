#!/bin/bash
set -euo pipefail

HOME_DIR="$HOME"
DOWNLOADS=$(readlink -f "$HOME_DIR/Downloads")
DOCS=$(readlink -f "$HOME_DIR/Documents")
IMAGES=$(readlink -f "$HOME_DIR/Pictures")
MUSIC=$(readlink -f "$HOME_DIR/Music")
VIDEOS=$(readlink -f "$HOME_DIR/Videos")
LOGFILE="$HOME_DIR/bin/logs/organize.log"

# Ensure log file exists to avoid tee errors on first run
touch "$LOGFILE"

mkdir -p "$DOCS" "$IMAGES" "$MUSIC" "$VIDEOS"

# move_files_updated() {
#   local dest="${!#}"
#   local exts=("${@:1:$#-1}") # all arguments except the last are extensions
#
#
#   for ext in "${exts[@]}"; do
#     local directory_name =
#   done
# }
#
move_files() {
  local dest="${!#}"         # last argument is the destination
  local exts=("${@:1:$#-1}") # all arguments except the last are extensions
  local find_expr=()

  # --- FIX START ---
  # Build the find expression array with a proper "-o" (OR) between each extension
  for ext in "${exts[@]}"; do
    find_expr+=(-iname "*.${ext}" -o)
  done

  # If the array has elements, remove the trailing "-o" from the last element
  if [ ${#find_expr[@]} -gt 0 ]; then
    unset 'find_expr[-1]'
  else
    # If no extensions were provided, do nothing.
    echo "[INFO] No extensions provided for destination $dest" | tee -a "$LOGFILE"
    return
  fi
  # --- FIX END ---

  # The find command with proper grouping and process substitution
  while IFS= read -r file; do
    if mv -v "$file" "$dest"/ &>>"$LOGFILE"; then
      echo "[OK] Moved: $file -> $dest" | tee -a "$LOGFILE"
    else
      echo "[ERROR] Failed: $file -> $dest" | tee -a "$LOGFILE"
    fi
    # Note the space after the opening parenthesis for the find expression
  done < <(find "$DOWNLOADS" -maxdepth 1 -type f \( "${find_expr[@]}" \))
}

echo "--- Starting file organization at $(date) ---" | tee -a "$LOGFILE"

move_files pdf doc docx txt odt "$DOCS"
move_files jpg jpeg png gif webp "$IMAGES"
move_files mp3 wav ogg flac "$MUSIC"
move_files mp4 mkv avi mov webm "$VIDEOS"

echo "--- Finished file organization ---" | tee -a "$LOGFILE"
