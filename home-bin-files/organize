#!/bin/bash
set -euo pipefail

HOME_DIR="$HOME"
DOWNLOADS=$(readlink -f "$HOME_DIR/Downloads")
LOGFILE="$HOME_DIR/bin/logs/organize.log"

# Ensure log file exists
touch "$LOGFILE"

# Arguments
SRC="${1:-$DOWNLOADS}"           # default to Downloads if no source path
DEST="${2:-$HOME_DIR/Documents}" # default to Documents if no dest

# Ensure destination folder exists
mkdir -p "$DEST"

move_docs() {
  while IFS= read -r file; do
    ext="${file##*.}"
    ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    case "$ext_lower" in
    iso)
      folder="ISOS"
      ;;
    pdf)
      folder="PDF"
      ;;
    doc | docx | odt)
      folder="TXT"
      ;;
    txt)
      folder="OTHERS"
      ;;
    *)
      continue
      ;;
    esac

    target="$DEST/$folder"
    mkdir -p "$target"

    if mv -v "$file" "$target"/ &>>"$LOGFILE"; then
      echo "[OK] Moved: $file -> $target" | tee -a "$LOGFILE"
    else
      echo "[ERROR] Failed: $file -> $target" | tee -a "$LOGFILE"
    fi
  done < <(find "$SRC" -maxdepth 1 -type f \( -iname "*.iso" -o -iname "*.pdf" -o -iname "*.doc" -o -iname "*.docx" -o -iname "*.odt" -o -iname "*.txt" \))
}

move_files() {
  local dest="$DEST"
  local exts=("$@")
  local find_expr=()

  for ext in "${exts[@]}"; do
    find_expr+=(-iname "*.${ext}" -o)
  done
  unset 'find_expr[-1]'

  while IFS= read -r file; do
    if mv -v "$file" "$dest"/ &>>"$LOGFILE"; then
      echo "[OK] Moved: $file -> $dest" | tee -a "$LOGFILE"
    else
      echo "[ERROR] Failed: $file -> $dest" | tee -a "$LOGFILE"
    fi
  done < <(find "$SRC" -maxdepth 1 -type f \( "${find_expr[@]}" \))
}

echo "--- Starting file organization at $(date) ---" | tee -a "$LOGFILE"

# Determine if destination is Documents for special handling
if [[ "$DEST" == "$HOME_DIR/Documents" ]]; then
  move_docs
else
  # For other folders, move everything together without subfolders
  move_files pdf doc docx txt odt jpg jpeg png gif webp mp3 wav ogg flac mp4 mkv avi mov webm iso
fi

echo "--- Finished file organization ---" | tee -a "$LOGFILE"
